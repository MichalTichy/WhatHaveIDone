@page "/"
@page "/time"
@inherits AppComponentBase
<PageTitle>@Strings.Time · @Strings.AppName</PageTitle>
<div class="page-header"><div><h1>@Strings.Time</h1><p class="page-subtitle">@Strings.TimeSubtitle</p></div><span class="timezone-label">@User.Settings.TimeZone</span></div>
@if (Error is not null) { <div class="alert error" role="alert">@Error <button class="quiet" @onclick="LoadAsync">@Strings.Retry</button></div> }
<section class="surface timer-card @(runningEntry is not null ? "is-running" : "")">
    @if (runningEntry is { } active)
    {
        <div class="timer-main">
            <div class="timer-description">
                <span class="timer-caption"><span class="timer-indicator" aria-hidden="true"></span>@Strings.Running</span>
                <strong>@(string.IsNullOrWhiteSpace(active.Description) ? Strings.NoDescription : active.Description)</strong>
                <div class="entry-subline">
                    <span>@User.ProjectName(active.ProjectId)</span>
                    @foreach (var tag in active.Tags)
                    {
                        <span class="entry-tag">@tag</span>
                    }
                </div>
            </div>
            <div class="timer-action">
                <output>@UserTime.Duration((now - active.Start).TotalSeconds)</output>
                <button type="button" class="secondary" disabled="@Busy" aria-expanded="@showNewTimer" @onclick="() => showNewTimer = !showNewTimer">@Strings.StartNew</button>
                <AppActionButton Class="timer-stop" Variant="ButtonVariant.Destructive" Disabled="Busy" OnClick="StopAsync">@Strings.StopTimer</AppActionButton>
            </div>
        </div>
    }
    @if (runningEntry is null || showNewTimer)
    {
        <div class="timer-main timer-composer">
            <div class="timer-description">
                <BbInput Class="app-input timer-description-input" UpdateTiming="UpdateTiming.Immediate" AriaLabel="@Strings.Description" Placeholder="@Strings.WorkingOn" Value="@description" ValueChanged="value => description = value ?? string.Empty" />
                @if (narrow)
                {
                    <button type="button" class="quiet timer-details-toggle" aria-expanded="@showTimerFields" @onclick="() => showTimerFields = !showTimerFields">
                        @User.ProjectName(projectId) · @Strings.Tags (@selectedTags.Count)
                    </button>
                }
            </div>
            <AppActionButton Class="timer-start" Disabled="Busy" OnClick="StartAsync">
                <span class="timer-start-icon" aria-hidden="true"></span><span>@Strings.StartTimer</span>
            </AppActionButton>
        </div>
        @if (!narrow || showTimerFields)
        {
            <div class="timer-fields">
                <ProjectPicker @bind-Value="projectId" />
                <TagInput @bind-Value="selectedTags" ProjectId="@projectId" />
            </div>
        }
    }
</section>
<div class="toolbar"><div class="tabs"><button class="@(!calendarView ? "active" : "")" aria-pressed="@(!calendarView)" @onclick="ShowList">@Strings.List</button><button class="@(calendarView ? "active" : "")" aria-pressed="@calendarView" @onclick="ShowCalendar">@Strings.Calendar</button></div><AppActionButton OnClick="AddAsync">＋ @Strings.AddEntry</AppActionButton></div>
<div class="period">
    <div class="actions">
        <div class="period-navigation">
            <button class="secondary" aria-label="@Strings.PreviousWeek" title="@Strings.PreviousWeek" @onclick="() => MoveDayAsync(-7)">«</button>
            <button class="secondary" aria-label="@Strings.PreviousDay" title="@Strings.PreviousDay" @onclick="() => MoveDayAsync(-1)">‹</button>
            <button class="secondary" @onclick="TodayAsync">@Strings.Today</button>
            <button class="secondary" aria-label="@Strings.NextDay" title="@Strings.NextDay" @onclick="() => MoveDayAsync(1)">›</button>
            <button class="secondary" aria-label="@Strings.NextWeek" title="@Strings.NextWeek" @onclick="() => MoveDayAsync(7)">»</button>
        </div>
        <input aria-label="@Strings.Period" class="date-input" type="date" @bind="selectedDay" @bind:format="yyyy-MM-dd" @bind:after="LoadAsync" />
    </div>
    <div style="text-align: right">
        <strong class="period-total">
            <span>@string.Format(Strings.MonthTotal, selectedDay.ToString("MMMM yyyy"))</span>
            @if (IsLoading)
            {
                <span role="status" aria-label="@Strings.Loading">…</span>
            }
            else if (loaded && Error is null)
            {
                @UserTime.Duration(TotalSeconds())
            }
        </strong>
        @if (User.Settings.PredictionEnabled)
        {
            <MonthlyPrediction Revision="predictionRevision" />
        }
    </div>
</div>
@if (IsLoading && !loaded) { <Loading /> }
else if (loaded)
{
    @if (calendarView) { <section class="surface"><div @ref="calendarElement"></div></section> }
    else if (entries.Count == 0) { <section class="surface empty">@Strings.EmptyTime</section> }
    else
    {
        <section class="surface entries">@foreach(var day in Days().Reverse())
        {
            var daily = DayEntries(day).ToList();
            @if (daily.Count > 0)
            {
                <div class="entry-day"><strong>@day.ToString("ddd d. M.")</strong><strong>@UserTime.Duration(DaySeconds(day, daily))</strong></div>
                @foreach(var row in DayRows(day, daily))
                {
                    @if (row.Entry is { } entry)
                    {
                        <div class="entry-row" style="--project-color:@User.ProjectColor(entry.ProjectId)" @key="(entry.Id,day)"><button class="entry-open" @onclick="() => OpenAsync(entry.Id)"><strong>@(string.IsNullOrEmpty(entry.Description) ? Strings.NoDescription : entry.Description)</strong><small class="entry-subline"><span>@User.ProjectName(entry.ProjectId)</span>@foreach(var tag in entry.Tags){<span class="entry-tag">@tag</span>}</small>@if (Overlaps(entry)){<small class="warning-text">⚠ @Strings.OverlapShort</small>}</button><div class="entry-meta"><strong>@UserTime.Duration(((entry.End ?? now) - entry.Start).TotalSeconds)</strong>@UserTime.Local(entry.Start, User.Settings.TimeZone).ToString("HH:mm")–@(entry.End.HasValue ? UserTime.Local(entry.End.Value, User.Settings.TimeZone).ToString("HH:mm") : Strings.Running)</div><button class="secondary entry-continue" aria-label="@(Strings.Continue + ": " + entry.Description)" disabled="@Busy" @onclick="() => ContinueAsync(entry)">▶</button></div>
                    }
                    else
                    {
                        <button class="entry-gap" @key="(day,row.Start,row.End)" disabled="@IsLoading"
                                aria-label="@string.Format(Strings.FillGap, GapTime(row.Start), GapTime(row.End), UserTime.Duration((row.End-row.Start).TotalSeconds))"
                                @onclick="() => FillGap(row.Start, row.End)">
                            <span class="gap-icon" aria-hidden="true">＋</span>
                            <span class="gap-label"><strong>@Strings.UntrackedTime</strong><small>@GapTime(row.Start)–@GapTime(row.End) · @UserTime.Duration((row.End-row.Start).TotalSeconds)</small></span>
                            <span class="gap-action">@Strings.AddEntry</span>
                        </button>
                    }
                }
            }
        }</section>
    }
}
@if (editorOpen) { <TimeEntryEditor @key="editorKey" Entry="editingEntry" InitialStart="editorStart" InitialEnd="editorEnd" Saved="OnSavedAsync" Closed="OnClosedAsync" /> }
