@inherits AppComponentBase
<NavigationLock ConfirmExternalNavigation="@(revision > savedRevision)" OnBeforeInternalNavigation="BeforeNavigationAsync" />
<dialog class="drawer" @ref="dialog" aria-labelledby="entry-editor-title">
    <div class="drawer-content">
        <header class="drawer-header"><h2 id="entry-editor-title">@(id is null ? Strings.AddEntry : Strings.EditEntry)</h2><button aria-label="@Strings.Close" class="secondary" @onclick="RequestCloseAsync">×</button></header>
        <div class="drawer-body">
            <label>@Strings.Description<input value="@description" @oninput="DescriptionChangedAsync" @onchange="FlushAsync" maxlength="4000" /></label>
            <ProjectPicker Value="@projectId" ValueChanged="ProjectChangedAsync" OriginalProject="@originalProject" />
            <TagInput Value="selectedTags" ValueChanged="TagsChangedAsync" ProjectId="@projectId" />
            <label>@Strings.Start<input type="datetime-local" step="1" value="@localStart" @oninput="StartChangedAsync" @onchange="FlushAsync" /></label>
            @if (Ambiguous(localStart)) { <label>@Strings.Offset<select class="offset-select" @bind="startOffset" @bind:after="OffsetChangedAsync">@foreach(var offset in Offsets(localStart)) { <option value="@offset">@offset</option> }</select></label> }
            @if (running) { <p>@Strings.Running</p> }
            else
            {
                <label>@Strings.End<input type="datetime-local" step="1" value="@localEnd" @oninput="EndChangedAsync" @onchange="FlushAsync" /></label>
                @if (Ambiguous(localEnd)) { <label>@Strings.Offset<select class="offset-select" @bind="endOffset" @bind:after="OffsetChangedAsync">@foreach(var offset in Offsets(localEnd)) { <option value="@offset">@offset</option> }</select></label> }
            }
            <p class="muted">@User.Settings.TimeZone</p>
            @if (overlap) { <p class="alert">@Strings.Overlap</p> }
            @if (Error is not null) { <div class="alert error" role="alert">@Error</div> }
            @if (conflict) { <button class="secondary" @onclick="ReloadAsync">@Strings.Reload</button> }
            else if (authenticationExpired) { <button class="secondary" @onclick="SignInAgain">@Strings.SignIn</button> }
            else if (failed) { <button class="secondary" @onclick="SaveAsync">@Strings.Retry</button> }
            @if (id is not null)
            {
                <details class="entry-more"><summary>@Strings.MoreActions</summary><button class="danger" disabled="@saving" @onclick="DeleteAsync">@Strings.Delete</button></details>
            }
        </div>
        <footer class="drawer-footer"><span class="muted" role="status">@status</span><span class="spacer"></span>
            @if (id is null) { <AppActionButton Disabled="saving" OnClick="CreateAsync">@Strings.CreateEntry</AppActionButton> }
            <AppActionButton Disabled="closing" OnClick="RequestCloseAsync">@Strings.Close</AppActionButton>
        </footer>
    </div>
</dialog>
