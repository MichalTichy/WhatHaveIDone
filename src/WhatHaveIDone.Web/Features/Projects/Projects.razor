@page "/projects"
@inherits AppComponentBase
<PageTitle>@Strings.Projects · @Strings.AppName</PageTitle>
<div class="page-header"><h1>@Strings.Projects</h1><AppActionButton OnClick="Add">＋ @Strings.AddProject</AppActionButton></div>
@if (Error is not null && editing is null) { <p class="alert error" role="alert">@Error <button @onclick="LoadAsync">@Strings.Reload</button></p> }
<div class="toolbar field-actions"><label class="grow">@Strings.Search<input @bind="search" @bind:event="oninput" /></label><div class="tabs"><button class="@(!archived ? "active" : "")" @onclick="() => archived = false">@Strings.Active</button><button class="@(archived ? "active" : "")" @onclick="() => archived = true">@Strings.Archived</button></div></div>
@if (!loaded && Busy) { <Loading /> }
else if (loaded)
{
    <section class="surface">@if (!Visible.Any()){<p class="empty">@Strings.NoProjects</p>}@foreach(var project in Visible)
    { <div class="project-row"><span class="swatch" style="--project-color:@project.Color"></span><button class="entry-open grow" @onclick="() => Edit(project)"><strong>@project.Name</strong><small>@User.ClientName(project.ClientId)</small></button><button class="secondary" disabled="@Busy" @onclick="() => ToggleArchiveAsync(project)">@(project.Archived ? Strings.Restore : Strings.Archive)</button></div> }</section>
}
@if (editing is not null)
{
    <dialog class="drawer" @ref="dialog" aria-labelledby="project-title"><form class="drawer-content" @onsubmit="SaveAsync" @onsubmit:preventDefault><header class="drawer-header"><h2 id="project-title">@Strings.Project</h2><button type="button" class="secondary" aria-label="@Strings.Close" @onclick="CloseAsync">×</button></header><div class="drawer-body"><label>@Strings.Name<BbInput Class="app-input" UpdateTiming="UpdateTiming.Immediate" AriaLabel="@Strings.Name" Value="@editing.Name" ValueChanged="value => editing.Name = value ?? string.Empty" /></label><ClientPicker @bind-Value="editing.ClientId" /><ProjectColorPicker @bind-Value="editing.Color" ProjectId="@editing.Id" />@if(Error is not null){<p class="alert error" role="alert">@Error</p>}</div><footer class="drawer-footer">
        @if (!string.IsNullOrEmpty(editing.Id))
        {
            <button type="button" class="danger" disabled="@Busy" @onclick="DeleteProjectAsync">@Strings.Delete</button>
        }
        <span class="spacer"></span><button type="button" class="secondary" @onclick="CloseAsync">@Strings.Cancel</button><AppActionButton Type="ButtonType.Submit" Disabled="Busy">@Strings.Save</AppActionButton></footer></form></dialog>
}
