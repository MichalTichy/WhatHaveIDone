@page "/reports"
@inherits AppComponentBase
<PageTitle>@Strings.Reports · @Strings.AppName</PageTitle>
<div class="page-header"><h1>@Strings.Reports</h1>@if(report is not null){<a class="button secondary" href="@CsvUrl">@Strings.ExportCsv</a>}</div>
@if(Error is not null){<p class="alert error" role="alert">@Error</p>}
<form class="surface stack report-filters" @onsubmit="LoadAsync" @onsubmit:preventDefault>
    <div class="actions report-periods">
        @foreach (var period in Periods())
        {
            <button type="button" class="secondary" aria-pressed="@(startDate == period.From && endDate == period.Through ? "true" : "false")"
                    @onclick="() => SelectPeriodAsync(period.From, period.Through)">@period.Label</button>
        }
    </div>
    <div class="form-grid"><label>@Strings.From<input type="date" @bind="startDate" @bind:format="yyyy-MM-dd" required /></label><label>@Strings.To<input type="date" @bind="endDate" @bind:format="yyyy-MM-dd" required /></label><SearchableSelect Label="@Strings.Project" EmptyMessage="@Strings.NoProjects" Options="ProjectOptions" Value="@project" ValueChanged="SelectProject" />
        <SearchableSelect Label="@Strings.Tags" Options="TagOptions" Value="@tag" ValueChanged="SelectTag" /></div>
    <label>@Strings.FilterDescription<input @bind="text" /></label><div class="actions"><AppActionButton Type="ButtonType.Submit" Disabled="IsLoading">@Strings.Apply</AppActionButton><button type="button" class="secondary" @onclick="ResetAsync">@Strings.ClearFilters</button><span class="muted">@User.Settings.TimeZone</span></div>
</form>
<div class="toolbar"><div class="tabs"><button class="@(!detail ? "active" : "")" @onclick="() => detail = false">@Strings.Summary</button><button class="@(detail ? "active" : "")" @onclick="() => detail = true">@Strings.Detail</button></div>@if(report is not null){<strong>@Strings.Total @UserTime.Duration(report.TotalSeconds)</strong>}</div>
@if(IsLoading && report is null){<Loading />}
else if(report is not null)
{
    @if (!detail)
    {
        <div class="report-grid report-overview">
            <section class="surface">
                <h2>@Strings.ByProject</h2>
                @if (projectPie is not null)
                {
                    <div class="report-pie" style="background-image: @projectPie" aria-hidden="true"></div>
                }
                @if (report.Projects.Count == 0)
                {
                    <p class="muted">@Strings.EmptyTime</p>
                }
                @foreach (var bucket in report.Projects)
                {
                    <button type="button" class="report-bucket project-row" disabled="@IsLoading"
                            aria-label="@($"{string.Format(Strings.FilterBy, User.ProjectName(bucket.Key))} · {UserTime.Duration(bucket.Seconds)}")"
                            @onclick="() => FilterProjectAsync(bucket.Key)">
                        <span class="swatch" style="--project-color:@User.ProjectColor(bucket.Key)"></span>
                        <span class="grow">@User.ProjectName(bucket.Key)</span>
                        <strong>@UserTime.Duration(bucket.Seconds)</strong>
                    </button>
                }
            </section>
            <section class="surface">
                <h2>@Strings.ByDay</h2>
                <div class="report-calendar">
                    @foreach (var month in ActivityMonths())
                    {
                        <div class="report-month" @key="month">
                            <div class="report-month-heading">
                                <h3>@month.ToString("Y")</h3>
                                <strong title="@Strings.Total">@UserTime.Duration(MonthSeconds(month))</strong>
                            </div>
                            <div class="report-month-grid">
                                @foreach (var weekday in WeekdayLabels())
                                {
                                    <span class="report-weekday">@weekday</span>
                                }
                                @foreach (var day in ActivityDays(month))
                                {
                                    var seconds = activity.GetValueOrDefault(day);
                                    var label = $"{day:D} · {UserTime.Duration(seconds)}";
                                    <button type="button" class="report-day" data-level="@ActivityLevel(seconds)"
                                            style="grid-column: @(WeekdayColumn(day.DayOfWeek) + 1); grid-row: @((day.Day - 1 + WeekdayColumn(month.DayOfWeek)) / 7 + 2)"
                                            title="@label" aria-label="@label" disabled="@IsLoading"
                                            @onclick="() => SelectPeriodAsync(day, day)">@day.Day</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
            <section class="surface report-statistics">
                <h2>@Strings.ReportStatistics</h2>
                <p class="muted report-statistics-period">@StatisticsPeriod</p>
                <p class="muted">@Strings.ReportStatisticsScope</p>
                <dl class="report-statistics-summary">
                    @foreach (var statistic in SummaryStatistics())
                    {
                        <div>
                            <dt>@StatisticLabel(statistic.Name)</dt>
                            <dd>@StatisticValue(statistic)</dd>
                        </div>
                    }
                </dl>
                @foreach (var group in StatisticGroups())
                {
                    <section class="report-statistics-group">
                        <h3>@group.Key</h3>
                        <dl>
                            @foreach (var statistic in group)
                            {
                                <div class="report-statistic @(IsSubStatistic(statistic.Name) ? "report-statistic-subset" : "")">
                                    <dt title="@StatisticDescription(statistic.Name)">@StatisticLabel(statistic.Name)</dt>
                                    <dd>@StatisticValue(statistic)</dd>
                                </div>
                            }
                        </dl>
                    </section>
                }
            </section>
        </div>
    }
    else if (report.Entries.Count == 0)
    {
        <section class="surface empty">@Strings.EmptyTime</section>
    }
    else
    {
        <section class="surface table-scroll report-detail">
            <table class="data-table" role="table">
                <thead role="rowgroup">
                    <tr role="row"><th role="columnheader">@Strings.Description</th><th role="columnheader">@Strings.Project</th><th role="columnheader">@Strings.Tags</th><th role="columnheader">@Strings.Start</th><th role="columnheader">@Strings.End</th><th role="columnheader" class="numeric">@Strings.Duration</th></tr>
                </thead>
                <tbody role="rowgroup">
                    @foreach (var entry in report.Entries)
                    {
                        <tr role="row" @key="entry.Id">
                            <td role="cell" class="report-description">
                                <button type="button" class="text-action" disabled="@(IsLoading || string.IsNullOrEmpty(entry.Description))" @onclick="() => FilterDescriptionAsync(entry.Description)">@(string.IsNullOrEmpty(entry.Description) ? Strings.NoDescription : entry.Description)</button>
                                @if (Overlaps(entry)) { <small class="warning-text">@Strings.OverlapShort</small> }
                            </td>
                            <td role="cell" class="report-project"><button type="button" class="text-action" disabled="@IsLoading" @onclick="() => FilterProjectAsync(entry.ProjectId)">@User.ProjectName(entry.ProjectId)</button></td>
                            <td role="cell" class="report-tag-cell">
                                <div class="report-tags">
                                    @foreach (var name in entry.Tags)
                                    {
                                        <button type="button" class="tag-pill" disabled="@IsLoading" @onclick="() => FilterTagAsync(name)">@name</button>
                                    }
                                </div>
                            </td>
                            <td role="cell" class="report-start"><span class="report-mobile-label">@Strings.Start</span>@UserTime.Local(entry.Start, User.Settings.TimeZone).ToString("g")</td>
                            <td role="cell" class="report-end"><span class="report-mobile-label">@Strings.End</span>@(entry.End.HasValue ? UserTime.Local(entry.End.Value, User.Settings.TimeZone).ToString("g") : Strings.Running)</td>
                            <td role="cell" class="report-duration numeric"><span class="report-mobile-label sr-only">@Strings.Duration</span>@UserTime.Duration(UserTime.Seconds(entry.Start, entry.End, report.CalculatedAt, appliedFrom, appliedTo))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}
