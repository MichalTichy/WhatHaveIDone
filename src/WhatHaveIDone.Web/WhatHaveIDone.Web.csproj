<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <ItemGroup>
    <ProjectReference Include="../WhatHaveIDone.Contracts/WhatHaveIDone.Contracts.csproj" />
</ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="LumexUI" Version="2.4.0" />
</ItemGroup>
  <ItemGroup><EmbeddedResource Update="Resources/Strings.resx"><Generator /><StronglyTypedLanguage>C#</StronglyTypedLanguage><StronglyTypedNamespace>WhatHaveIDone.Web.Resources</StronglyTypedNamespace><StronglyTypedClassName>Strings</StronglyTypedClassName><StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName><PublicClass>true</PublicClass></EmbeddedResource></ItemGroup>
  <PropertyGroup><ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest><BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData></PropertyGroup>
  <ItemGroup><ServiceWorker Include="wwwroot/service-worker.js" PublishedContent="wwwroot/service-worker.published.js" /></ItemGroup>
  <ItemGroup><Content Remove="wwwroot/output.css;wwwroot/calendar.js" /><Content Include="wwwroot/output.css;wwwroot/calendar.js" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="RestoreWebDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules/.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" />
  </Target>
  <Target Name="BuildWebAssets" BeforeTargets="BeforeBuild" DependsOnTargets="CopyContents;RestoreWebDependencies">
    <Exec Command="npm run build" />
  </Target>
</Project>
