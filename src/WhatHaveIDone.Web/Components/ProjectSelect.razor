<div class="project-search">
    <label for="@triggerId">@Strings.Project</label>
    <div class="project-search-control">
        <button type="button" class="secondary project-search-trigger" id="@triggerId" popovertarget="@listId"
                aria-haspopup="listbox" @ref="trigger" @onclick="FocusSearchAsync">
            <span>@SelectedText</span><span aria-hidden="true">&#9662;</span>
        </button>
        @Action
    </div>
    <div class="project-search-popover" id="@listId" popover="auto" @ref="popover">
        <BbCommand @bind-SearchQuery="search" OnValueChange="SelectAsync">
            <BbCommandInput Placeholder="@Strings.Search" DisableDebounce="true" aria-label="@Strings.Search" />
            <BbCommandList>
                <BbCommandEmpty>@Strings.NoProjects</BbCommandEmpty>
                @foreach (var option in Options)
                {
                    <BbCommandItem @key="option.Value" Value="@("project:" + option.Value)" SearchText="@option.Text">
                        <span class="project-option-check" aria-hidden="true">@(option.Value == Value ? "✓" : "")</span>
                        @option.Text
                    </BbCommandItem>
                }
            </BbCommandList>
        </BbCommand>
    </div>
</div>
